# Used by Docker Compose. start.ps1 / app.py use OS environment variables.
# Generate a secret, then paste it below. Do not commit your .env file.
ADMIN_TOKEN=
LOCATION_TOKEN_SECRET=
ADMIN_HOSTS=admin.example.com
PUBLIC_PORT=5000
WEATHER_ENABLED=1
GEOCODING_ENABLED=1
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
# Production: append your real contact address; do not use a fake email.
GEOCODING_USER_AGENT=WateringPlatform/1.0
# Optional external JSON endpoints; keep the documented response shapes.
COUNTRIES_API_URL=https://raw.githubusercontent.com/mledoze/countries/master/countries.json
CHINA_AREAS_API_URL=https://geo.datav.aliyun.com/areas_v3/bound
CHINA_CITIES_API_URL=https://raw.githubusercontent.com/modood/Administrative-divisions-of-China/master/dist/pca-code.json
WORLD_CITIES_API_URL=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_populated_places_simple.geojson
TAIWAN_CITIES_API_URL=https://raw.githubusercontent.com/donma/TaiwanAddressCityAreaRoadChineseEnglishJSON/master/CityCountyData.json
DEMO_ENABLED=0
BLE_SERVICE_UUID=2d26a7cc-1d45-4eae-9280-2a97346fd001
BLE_WRITE_UUID=2d26a7cc-1d45-4eae-9280-2a97346fd002
BLE_NOTIFY_UUID=2d26a7cc-1d45-4eae-9280-2a97346fd003
